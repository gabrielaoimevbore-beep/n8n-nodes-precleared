{
  "name": "n8n-nodes-precleared",
  "version": "0.1.1",
  "description": "Check whether a cold or marketing email may be sent to a recipient, with the deciding rule, footer requirements and a signed receipt. Covers the UK, US, Canada, Germany, France, Australia, Ireland and the Netherlands.",
  "license": "MIT",
  "homepage": "https://precleared.dev",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "precleared",
    "cold email",
    "email compliance",
    "gdpr",
    "pecr",
    "can-spam",
    "casl"
  ],
  "author": {
    "name": "Gabriel Imevbore",
    "email": "support@precleared.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielaoimevbore-beep/n8n-nodes-precleared.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielaoimevbore-beep/n8n-nodes-precleared/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PreclearedApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Precleared/Precleared.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
